# Neon (free tier) — https://neon.tech
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/staybnb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/staybnb?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:3000"
PORT=4000

# Optional. Create a free Stripe account and use the test secret key (sk_test_...)
# to enable real Checkout redirects. Test mode never charges a real card.
# Leave blank to keep instant-confirm booking (no payment step).
STRIPE_SECRET_KEY=
